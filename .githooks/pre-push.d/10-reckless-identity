#!/usr/bin/env bash
#
# Reckless build: refuses a push that carries a new commit whose author or committer is not the
# fork's one identity. A rebase or cherry-pick runs no pre-commit hook, so this is the check that
# catches those. A commit already on any remote-tracking branch (upstream KiCad's included) is
# not new, so upstream's own authors pass.
#
# Git passes "<local ref> <local oid> <remote ref> <remote oid>" on stdin for each pushed ref.

expected="Jonny Reckless <jonny@recklesstechnology.com>"
zero=$(git hash-object --stdin < /dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a remote ref adds no commits
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi

    # Only a commit carrying another identity is printed
    wrong=$(git log --format='%h  author: %an <%ae>  committer: %cn <%ce>' "$local_oid" --not --remotes |
            grep -v -F "author: ${expected}  committer: ${expected}")

    if [ -n "$wrong" ]; then
        echo "ERROR: ${local_ref} carries commits that are not '${expected}' as author and committer:"
        echo "$wrong"
        echo "Fix them, for example with: git rebase --exec 'git commit --amend --no-edit --reset-author' <base>"
        status=1
    fi
done

exit $status
