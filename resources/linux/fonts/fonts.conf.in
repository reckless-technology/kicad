<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Reckless build: fontconfig settings for KiCad's processes only. KiCad's desktop entries point FONTCONFIG_FILE
  here, so no other program reads it. It includes the system configuration first, then makes "monospace" resolve
  to the house fixed-width font.
-->
<fontconfig>
  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>
  <alias binding="same">
    <family>monospace</family>
    <prefer>
      <family>Monaspace Xenon</family>
    </prefer>
  </alias>
</fontconfig>
