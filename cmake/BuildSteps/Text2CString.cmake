# CMake script file to turn a text file into a C/C++ string literal, one literal per line, for an #include inside an
# initializer. It reads the file whole, so brackets and semicolons in the text (which file(STRINGS) and CMake lists
# treat specially) come through unchanged, and it escapes backslashes and double quotes.

file( READ ${inputFile} content )
string( REPLACE "\\" "\\\\" content "${content}" )
string( REPLACE "\"" "\\\"" content "${content}" )
string( REPLACE "\n" "\\n\"\n\"" content "${content}" )
get_filename_component( inputName ${inputFile} NAME )
file( WRITE ${outputFile} "// Do not edit this file, it is autogenerated by CMake from ${inputName}\n\"${content}\"\n" )
